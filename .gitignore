# 依赖
node_modules/

# 构建产物
dist/
build/
out/

# 日志
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 编辑器 / IDE
.idea/
.vscode/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db
ehthumbs.db

# 缓存 / 临时
.cache/
.temp/
.tmp/
*.tmp

# npm 打包临时产物（npm pack / scripts/release.mjs）
*.tgz

# syncx 同步指纹缓存（由 scripts/sync.sh 生成，内容未变化时跳过同步）
.syncx-fingerprint

# 环境变量 / 密钥（切勿提交）
.env
.env.local
.env.*.local

# 测试覆盖率
coverage/
.nyc_output/

# syncx 运行时目录
.syncx/
.workbuddy/

# 本地调试文件
*.local

# 注意:syncx 冲突副本(*.sync-conflict-*)不要写在这里!
# syncx 默认遵循 .gitignore —— 一旦 ignore,扫描器就不再回溯这些路径,
# 已入库的副本条目永远不会转墓碑,目录卡冲突徽标会卡死在旧计数。
# 「git 别误提交副本」的需求放 .git/info/exclude(仅本机 git 可见,syncx 不读)。
