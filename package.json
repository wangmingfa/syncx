{
  "name": "syncx",
  "version": "0.1.0",
  "description": "Peer-to-peer LAN file synchronization tool (Syncthing-like) in Node.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts start --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "multicast-dns": "^7.2.5",
    "ws": "^8.21.3"
  }
}
