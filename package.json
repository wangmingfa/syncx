{
  "name": "syncx",
  "version": "0.1.0",
  "description": "Peer-to-peer LAN file synchronization tool (Syncthing-like) in Node.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite dev --config vite.config.ts & tsx watch src/main.ts start --host 0.0.0.0 --expose-control; wait",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "npm run build:app && npm run build:web",
    "build:app": "tsc",
    "build:web": "vite build --config vite.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/multicast-dns": "^7.2.4",
    "@types/node": "^26.2.0",
    "@types/pino": "^7.0.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/server-renderer": "^3.5.41",
    "multicast-dns": "^7.2.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "vite": "^8.2.1",
    "vue": "^3.5.41",
    "ws": "^8.21.3"
  }
}
